# Copy this file to .env and fill in real values before running `npm run dev`
# or `npm run build`. Never commit the real .env — it's gitignored.

# --- Server-side (read via process.env, never sent to the browser) ---

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=""

# Supabase publishable/anon key — read-only fallback if the service role
# key below isn't set. Safe to expose; every table revokes browser writes.
SUPABASE_PUBLISHABLE_KEY=""

# Supabase service role key — required for the sync/ingest/prediction/
# analysis/backtest engines to write. Get it from
# Supabase dashboard → Project Settings → API → service_role. NEVER
# expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=""

# Optional — enables the "AI insights" button on the Analysis page.
# Leave blank to disable that one feature; everything else still works.
LOVABLE_API_KEY=""

# Optional but recommended before making this deployment public — see
# "Security" in DEPLOY.md. Leave blank during local dev; every writing/
# costly server function stays open (current default) until this is set.
ADMIN_API_KEY=""

# Optional — a dedicated secret for the /api/public/hooks/uk49s-sync
# webhook, checked instead of the (public) Supabase publishable key.
# Generate with: openssl rand -hex 32
SYNC_WEBHOOK_SECRET=""

# --- Client-side (baked into the bundle at build time, VITE_ prefix) ---

VITE_SUPABASE_URL=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
